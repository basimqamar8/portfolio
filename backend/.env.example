# ==============================================================================
# Basim Qamar Portfolio — Backend Configuration
# ==============================================================================

# Server Environment
ENVIRONMENT=development
APP_NAME="Basim Qamar Portfolio API"
DEBUG=False

# Database URL
# Default local storage is SQLite. For PostgreSQL (e.g., Neon Serverless), use:
# DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./portfolio.db

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Rate Limiting & Spam Mitigation
MAX_SUBMISSIONS_PER_HOUR=20
